# ==========================================================================
# NEXUS TECH — .gitignore
# ==========================================================================

# --- Sistema operacional ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# --- Editores / IDEs ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- Node.js (caso um backend JS venha a ser adicionado) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- Backend / servidor (futuro) ---
server/vendor/
server/.env
server/.env.local
.env
.env.local
.env.*.local
*.sqlite
*.sqlite3

# --- Compilados / temporários ---
dist/
build/
coverage/
tmp/
temp/
*.tmp
