Options -Indexes
DirectoryIndex index.php

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso direto a diretórios sensíveis
    RewriteRule ^(includes|database|logs|tests)(/|$) - [R=404,L]
</IfModule>

# Protege arquivos sensíveis caso mod_rewrite não esteja ativo
<FilesMatch "^(config|functions|db|auth|cart|validation|repository|components|header|footer|admin-header|admin-footer)\.php$">
    Require all denied
</FilesMatch>
